<?xml version="1.0" encoding="UTF-8"?>
<!-- Unofficial Project Infinity-X 17 / Android 17 for Pixel 3 (blueline).
     Hardware trees are imported from the proven LineageOS 24.0 based Infinity-X port.
     The device, kernel and vendor source import workflows must finish before repo sync. -->
<manifest>
  <remote name="hecker-pixel3" fetch="https://github.com/" />

  <project name="its-hecker/infinity-blueline-devicetree"
           path="device/google/crosshatch"
           remote="hecker-pixel3" revision="main" />
  <project name="its-hecker/infinity-blueline-kernel"
           path="kernel/google/msm-4.9"
           remote="hecker-pixel3" revision="main" />
  <project name="its-hecker/infinity-blueline-vendor"
           path="vendor/google/blueline"
           remote="hecker-pixel3" revision="main" />

  <!-- Active Edge / Pixel 3 integration -->
  <project name="LineageOS/android_packages_apps_ElmyraService"
           path="packages/apps/ElmyraService" remote="hecker-pixel3"
           revision="lineage-24.0" />

  <!-- Legacy Snapdragon 845 HALs pinned to known Android 17 port revisions. -->
  <project name="xbill9/android_hardware_qcom_sdm845_display"
           path="hardware/qcom/sdm845/display" remote="hecker-pixel3"
           revision="299e03ac43b03a433346ec7d13fb3444f1f2d57d"
           upstream="refs/heads/lineage-24.0" groups="qcom,qcom_sdm845" />
  <project name="LineageOS/android_hardware_qcom_sdm845_gps"
           path="hardware/qcom/sdm845/gps" remote="hecker-pixel3"
           revision="71438e3fa19861a7fee23ea8a26f1ac6c90c5f85"
           upstream="refs/heads/lineage-23.2" groups="qcom,qcom_sdm845" />
  <project name="xbill9/android_hardware_qcom_audio"
           path="hardware/qcom/audio" remote="hecker-pixel3"
           revision="e2cae171b39b5f642b5192076a7cddcaa80f063a"
           upstream="refs/heads/lineage-23.2" groups="qcom,qcom_audio,pdk-qcom" />

  <!-- Legacy Linux 4.9 GNU binutils; clang-r416183b is in Infinity's
       inherited LineageOS snippet. -->
  <project name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9"
           path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
           remote="hecker-pixel3" revision="5e030eafe024784a73cdf47e6936ac0dbfc763dc"
           upstream="refs/heads/lineage-19.1" clone-depth="1" />
  <project name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9"
           path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
           remote="hecker-pixel3" revision="111258a10e017f067b27e6cfcea7619d753f3309"
           upstream="refs/heads/lineage-19.1" clone-depth="1" />

  <!-- Android 17 Vold's standard fscrypt ioctls are not implemented by the
       Pixel 3 Linux 4.9 kernel. The xbill9 version adds a working fallback
       to the legacy session keyring (as in our Lineage 24.0 port). -->
  <remove-project name="system_vold" />
  <project name="xbill9/android_system_vold" path="system/vold"
           remote="hecker-pixel3" revision="fce7dadf6510b8ac728eca0f77672daa582e2bb8"
           upstream="refs/heads/lineage-24.0" groups="pdk" />

  <!-- Early Android 17 bpf and zygote adaptations for the 4.9 backport.
       Keep Infinity's core and Connectivity initially, while using the
       legacy-fscrypt Vold fallback; runtime compatibility still needs tests. -->
  <remove-project name="LineageOS/android_system_bpf" />
  <project name="xbill9/android_system_bpf" path="system/bpf"
           remote="hecker-pixel3" revision="72b37ef9d9dba32ddddcd6bb62970c4cb9f42523"
           upstream="refs/heads/lineage-24.0" groups="pdk" />

  <remove-project name="platform/system/zygote" />
  <project name="xbill9/android_system_zygote" path="system/zygote"
           remote="hecker-pixel3" revision="d6dadb5e56c821e8dd44b13725d9de6e3085c733"
           upstream="refs/heads/lineage-24.0" groups="pdk" />
</manifest>
